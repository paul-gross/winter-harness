{
  "markdown": {
    "textWrap": "always",
    "lineWidth": 120,
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
    "unorderedListKind": "dashes"
  },
  // The doc lints' deliberate-violation fixtures are inputs to assertions, not
  // prose — reflowing them rewrites the very shapes the tests pin.
  "excludes": ["agent-context/scripts/fixtures/**"],
  "plugins": ["https://plugins.dprint.dev/markdown-0.22.1.wasm"]
}
